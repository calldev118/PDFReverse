# Slipgrid — environment template. Copy to .env and fill in real values.
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=change-me-to-a-long-random-hex-string

# Super admin bootstrap credentials (used only to create the super admin
# the first time the DB is initialised).
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=change-me

# "true" in production (HTTPS); "false" only for local HTTP testing.
COOKIE_SECURE=true

# Server port
PORT=8005
